# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# instagram runtime data (generated/cached, not source code)
instagram/output/
instagram/product-images/
instagram/reference-images/

# Obsidian — version vault config, ignore per-device state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian vault / local scratch (not part of the app)
.obsidian/
*.canvas
gemini-logs.csv
/2026-*.md

# supabase local CLI state (not source)
supabase/.temp/

# internal financial analysis — confidential (salary, cost structure, margins,
# break-even). Kept local only; must NOT be pushed to the public repo.
docs/pricing/
